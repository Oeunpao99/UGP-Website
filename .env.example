# Copy this file to .env (same folder as docker-compose.yml) and fill in
# real values before running `docker compose up -d --build`.
# .env is gitignored — never commit real secrets.

# --- Required ---------------------------------------------------------
# Signs admin_session / chat_session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Bootstraps the first admin user the first time the container starts
# with an empty database. Read once — safe to leave set after that.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Recommended once served over HTTPS / a real domain ---------------
COOKIE_SECURE=false

# --- Optional -----------------------------------------------------------
# Without these, the AI chatbot uses its offline fallback answers.
# Azure Portal > your Azure OpenAI resource > Keys and Endpoint.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Without this, the "Sign in with Google" chat gate shows a graceful
# "not available" message instead of the Google button.
GOOGLE_CLIENT_ID=

# --- Tuning -------------------------------------------------------------
WEB_WORKERS=4
