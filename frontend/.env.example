# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.
# Vite only exposes vars prefixed VITE_ to browser code, and only reads
# .env files from this (frontend/) directory — the backend's .env is
# a completely separate file read by a completely separate process.

# Same Google OAuth Client ID as the backend's GOOGLE_CLIENT_ID (the
# frontend renders the Sign-In button; the backend verifies the token).
VITE_GOOGLE_CLIENT_ID=

# Only needed if the frontend should talk to an API on a different
# origin than the one serving it. Leave unset in normal dev — the Vite
# dev server proxies /api to http://localhost:8000 (see vite.config.js).
# VITE_API_BASE=
