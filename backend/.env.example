# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.

# --- Sessions -----------------------------------------------------
# Signs admin_session / chat_session cookies. Use a long random string
# in any real deployment (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
SECRET_KEY=dev-secret-change-me

# Set to "true" once the site is served over HTTPS so cookies get the
# Secure flag. Leave "false" for local http://localhost dev.
COOKIE_SECURE=false

# --- Bootstrap admin ------------------------------------------------
# Creates the first admin user on startup if the admin_users table is
# empty. Leave unset after the first run — they're only read once.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-me-now

# --- Google Sign-In (chat gate) -------------------------------------
# OAuth Client ID from Google Cloud Console (APIs & Services >
# Credentials > OAuth Client ID > Web application). No client secret
# needed for this flow. Without it, the chat widget shows a graceful
# "sign-in not available" message instead of the Google button.
GOOGLE_CLIENT_ID=

# --- CORS -------------------------------------------------------------
# Comma-separated origins allowed to call the API with credentials.
# Only needed in development (Vite dev server on a different port);
# in production frontend + API share one origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- UPG Assistant (AI chatbot) --------------------------------------
# Optional. Without it, the chatbot falls back to a deterministic
# keyword matcher and still answers offline.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Storage ----------------------------------------------------------
# SQLite file holding quotes, CMS content, admin users and chat logs.
QUOTE_DB=../data/quotes.db

# --- Production static hosting ----------------------------------------
# Path to the built frontend (frontend/dist). Leave unset in dev —
# Vite serves the frontend and proxies /api instead.
FRONTEND_DIST=
